<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0"
   <title>Piano</title>

<style>
    .keyboard {
        display: flex;
}

    .key.white {
        width: 60px;
        height: 220px;
        border: 1px solid black;
        background: white;
}
</style>

</head>



<body>

<section class="piano">
  <h1>Play the Piano</h1>

  <div class="keyboard">
    <div class="key white"></div>
    <div class="key white"></div>
    <div class="key white"></div>
    <div class="key white"></div>
    <div class="key white"></div>
    <div class="key white"></div>
    <div class="key white"></div>
  </div>
</section>

</body>
</html>
